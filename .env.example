# Copy this file to .env and replace the placeholder with your DeepSeek API key.
DEEPSEEK_API_KEY=replace-with-your-key

# DeepSeek official OpenAI-compatible endpoint and current Flash model.
MINICODE_BASE_URL=https://api.deepseek.com
MINICODE_MODEL=deepseek-v4-flash

# Safety, budget, and M2 context settings.
MINICODE_MAX_STEPS=8
MINICODE_REQUEST_TIMEOUT=120
MINICODE_MAX_TOOL_CHARS=12000
MINICODE_MAX_CONTEXT_CHARS=50000
MINICODE_ARTIFACT_THRESHOLD=6000

# Optional M3 cost estimate. Copy the current prices from your provider account;
# MiniCode records them as a report snapshot instead of hard-coding volatile prices.
# MINICODE_INPUT_COST_PER_MILLION=
# MINICODE_OUTPUT_COST_PER_MILLION=
